generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id       Int    @id
  name     String
  username String
  email    String
  posts    Post[]
}

model Post {
  id     Int    @id
  userId Int
  title  String
  body   String
  user   User   @relation(fields: [userId], references: [id])
}
